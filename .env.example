# =============================================================================
# BarPilot Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Your Supabase anonymous/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# OAuth Providers (Google & Facebook)
# Note: Google Client Secret and Facebook App Secret are configured securely
# inside the Supabase Dashboard: Project Settings > Authentication > Providers.
# They MUST NEVER be exposed in frontend bundles or client code.
# -----------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console)
# Authorized Redirect URI in Google Cloud: https://<your-supabase-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret (Set in Supabase Dashboard only)

# Facebook Login (Meta for Developers)
# Valid OAuth Redirect URI in Meta: https://<your-supabase-ref>.supabase.co/auth/v1/callback
FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret (Set in Supabase Dashboard only)

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Your Stripe secret key (found in Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=your-stripe-secret-key

# Your Stripe webhook signing secret (found after creating a webhook endpoint)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# The public URL of your application (used for redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
