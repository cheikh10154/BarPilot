# =============================================================================
# BarPilot Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Your Supabase anonymous/public key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Your Stripe secret key (found in Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=your-stripe-secret-key

# Your Stripe webhook signing secret (found after creating a webhook endpoint)
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# The public URL of your application (used for redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
