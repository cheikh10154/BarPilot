{
  "version": 2,
  "name": "barpilot",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "landing.html",
      "use": "@vercel/static"
    },
    {
      "src": "locales/**",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "demo.html",
      "use": "@vercel/static"
    },
    {
      "src": "demo/**",
      "use": "@vercel/static"
    },
    {
      "src": "checkout.html",
      "use": "@vercel/static"
    },
    {
      "src": "checkout/**",
      "use": "@vercel/static"
    },
    {
      "src": "pro.html",
      "use": "@vercel/static"
    },
    {
      "src": "pro/**",
      "use": "@vercel/static"
    },
    {
      "src": "gestisci-abbonamento.html",
      "use": "@vercel/static"
    },
    {
      "src": "gestisci-abbonamento/**",
      "use": "@vercel/static"
    },
    {
      "src": "affiliazioni.html",
      "use": "@vercel/static"
    },
    {
      "src": "administration/**",
      "use": "@vercel/static"
    },
    {
      "src": "administration.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": ".well-known/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/send-welcome-email/?$",
      "dest": "/api/send-welcome-email.js"
    },
    {
      "src": "^/api/stripe-webhook/?$",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "^/api/create-checkout-session/?$",
      "dest": "/api/create-checkout-session.js"
    },
    {
      "src": "^/api/create-portal-session/?$",
      "dest": "/api/create-portal-session.js"
    },
    {
      "src": "^/api/register-bar/?$",
      "dest": "/api/register-bar.js"
    },
    {
      "src": "^/api/generate-invoice/?$",
      "dest": "/api/generate-invoice.js"
    },
    {
      "src": "^/api/create-ticket/?$",
      "dest": "/api/create-ticket.js"
    },
    {
      "src": "^/api/cancel-subscription/?$",
      "dest": "/api/cancel-subscription.js"
    },
    {
      "src": "^/api/reactivate-subscription/?$",
      "dest": "/api/cancel-subscription.js"
    },
    {
      "src": "^/api/contact/?$",
      "dest": "/api/contact.js"
    },
    {
      "src": "^/api/affiliates/?$",
      "dest": "/api/affiliates.js"
    },
    {
      "src": "^/api/admin-affiliates/?$",
      "dest": "/api/affiliates.js"
    },
    {
      "src": "^/\\.well-known/(.*)$",
      "dest": "/.well-known/$1"
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/sitemap.xml"
    },
    {
      "src": "^/robots.txt$",
      "dest": "/robots.txt"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/favicon.ico"
    },
    {
      "src": "^/locales/(.*)$",
      "dest": "/locales/$1"
    },
    {
      "src": "^/landing(\\.html)?/?$",
      "dest": "/landing.html"
    },
    {
      "src": "^/(it|fr)/?$",
      "dest": "/landing.html"
    },
    {
      "src": "^/index(\\.html)?/?$",
      "dest": "/landing.html"
    },
    {
      "src": "^/$",
      "dest": "/landing.html"
    },
    {
      "src": "^/app/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/app/index.html$",
      "dest": "/index.html"
    },
    {
      "src": "^/app/demo/?$",
      "dest": "/demo.html"
    },
    {
      "src": "^/app/demo.html$",
      "dest": "/demo.html"
    },
    {
      "src": "^/app/pro/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/app/pro.html$",
      "dest": "/pro.html"
    },
    {
      "src": "^/app/offerta/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/app/checkout/?$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/app/checkout.html$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/app/gestisci-abbonamento/?$",
      "dest": "/gestisci-abbonamento.html"
    },
    {
      "src": "^/app/gestisci-abbonamento.html$",
      "dest": "/gestisci-abbonamento.html"
    },
    {
      "src": "^/app/affiliazioni/?$",
      "dest": "/affiliazioni.html"
    },
    {
      "src": "^/app/affiliazioni.html$",
      "dest": "/affiliazioni.html"
    },
    {
      "src": "^/app/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/app/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/app/manifest.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/app/service-worker.js$",
      "dest": "/service-worker.js"
    },
    {
      "src": "^/app/supporto/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/app/administration/supporto/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/app/administration/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/app/administration/admin\\.js$",
      "dest": "/administration/admin.js"
    },
    {
      "src": "^/app/administration/admin\\.css$",
      "dest": "/administration/admin.css"
    },
    {
      "src": "^/app/administration/(.*)$",
      "dest": "/administration/$1"
    },
    {
      "src": "^/app/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/app/admin/admin\\.js$",
      "dest": "/admin/admin.js"
    },
    {
      "src": "^/app/admin/admin\\.css$",
      "dest": "/admin/admin.css"
    },
    {
      "src": "^/app/admin/(.*)$",
      "dest": "/admin/$1"
    },
    {
      "src": "^/app/admin\\.js$",
      "dest": "/administration/admin.js"
    },
    {
      "src": "^/app/admin\\.css$",
      "dest": "/administration/admin.css"
    },
    {
      "src": "^/app/(.*)$",
      "dest": "/$1"
    },
    {
      "src": "^/demo/?$",
      "dest": "/demo.html"
    },
    {
      "src": "^/demo.html$",
      "dest": "/demo.html"
    },
    {
      "src": "^/pro/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/pro.html$",
      "dest": "/pro.html"
    },
    {
      "src": "^/offerta/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/checkout/?$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/checkout.html$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/gestisci-abbonamento/?$",
      "dest": "/gestisci-abbonamento.html"
    },
    {
      "src": "^/gestisci-abbonamento.html$",
      "dest": "/gestisci-abbonamento.html"
    },
    {
      "src": "^/affiliazioni/?$",
      "dest": "/affiliazioni.html"
    },
    {
      "src": "^/affiliazioni.html$",
      "dest": "/affiliazioni.html"
    },
    {
      "src": "^/administration/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/administration/(.*)$",
      "dest": "/administration/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/admin/(.*)$",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
