{
  "version": 2,
  "name": "barpilot",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "demo.html",
      "use": "@vercel/static"
    },
    {
      "src": "demo/**",
      "use": "@vercel/static"
    },
    {
      "src": "checkout.html",
      "use": "@vercel/static"
    },
    {
      "src": "checkout/**",
      "use": "@vercel/static"
    },
    {
      "src": "pro.html",
      "use": "@vercel/static"
    },
    {
      "src": "pro/**",
      "use": "@vercel/static"
    },
    {
      "src": "administration/**",
      "use": "@vercel/static"
    },
    {
      "src": "administration.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "service-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/send-welcome-email/?$",
      "dest": "/api/send-welcome-email.js"
    },
    {
      "src": "^/api/stripe-webhook/?$",
      "dest": "/api/stripe-webhook.js"
    },
    {
      "src": "^/demo/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/demo.html$",
      "dest": "/index.html"
    },
    {
      "src": "^/pro/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/pro.html$",
      "dest": "/pro.html"
    },
    {
      "src": "^/offerta/?$",
      "dest": "/pro.html"
    },
    {
      "src": "^/checkout/?$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/checkout.html$",
      "dest": "/checkout.html"
    },
    {
      "src": "^/administration/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/administration/(.*)$",
      "dest": "/administration/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/administration/index.html"
    },
    {
      "src": "^/admin/(.*)$",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
